# NVIDIA Integrate API (OpenAI-compatible)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Fast text first-pass + accurate vision escalate
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Processing
# hybrid = OCR/text first, escalate to vision when fields missing / financial fail / OCR null qty
# vision = vision-only (no OCR)
EXTRACTION_MODE=hybrid
MAX_FILE_SIZE_MB=20
PDF_TEXT_ALNUM_THRESHOLD=80
FINANCIAL_TOLERANCE=0.05
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=120
OCR_LANGUAGE=eng
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Parallel batch
BATCH_WORKERS=10
BATCH_RETRIES=2
BATCH_RETRY_BACKOFF_SECONDS=2.0

# Logging
LOG_LEVEL=INFO
