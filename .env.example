# NVIDIA Integrate API (OpenAI-compatible)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Text model for OCR/digital-text extraction (Nemotron)
NVIDIA_TEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Vision model for scanned/photographed documents
NVIDIA_VISION_MODEL=moonshotai/kimi-k3.1-pro

# Processing
MAX_FILE_SIZE_MB=20
PDF_TEXT_ALNUM_THRESHOLD=80
FINANCIAL_TOLERANCE=0.05
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=120
OCR_LANGUAGE=eng
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Logging
LOG_LEVEL=INFO
